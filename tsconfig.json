{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@businessportal/db": ["packages/db/src"],
      "@businessportal/ui": ["packages/ui/src"],
      "@businessportal/core": ["packages/core/src"]
    }
  },
  "include": [
    "apps/*/src",
    "apps/*/prisma",
    "packages/*/src"
  ]
}
